# Copy to .env (git-ignored) for local development.
#
# Both values are compiled into the JavaScript that every visitor downloads. They are NOT secrets:
# the anon key only works inside the limits of the row-level security in supabase/migrations.
# Never put the service_role key in this app or in any VITE_* variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
